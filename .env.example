# Copy to .env and fill in what you need. Everything is optional: keys and models can also be
# set in the app (Settings), and the app asks for a project folder when none is set.
# Values here override what is set in the app.

# Port of the local server (it only listens on 127.0.0.1).
# PORT=3000

# Project folder opened at startup. Default: the most recent project. `phi init` / `phi open`
# set it for you.
# PROJECT_ROOT=./sample-project

# Model provider: openrouter (default), anthropic, openai or mistral. Setting it pins the
# provider; leave it unset to choose in Settings. "faux" is an offline scripted model for
# development without a key.
# LLM_PROVIDER=openrouter

# Model of that provider, e.g. openrouter/free, claude-sonnet-5-5, gpt-5.5,
# mistral-large-latest. Leave it unset to choose in Settings.
# LLM_MODEL=

# API keys, one per provider. A key set here overrides the one saved in Settings.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=

# With LLM_PROVIDER=faux: slow the scripted replies down (tokens per second), e.g. to try Stop.
# FAUX_TOKENS_PER_SECOND=20
